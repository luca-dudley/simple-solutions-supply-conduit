# -----------------------------------------------------------------------------
# Supply Conduit - Monorepo Master Environment Variables Template
# -----------------------------------------------------------------------------

# Supabase Local / Cloud Connection
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase CLI Personal Access Token (Required for ./scripts/deploy-functions.sh)
# Generate from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token_here
# Optional: explicitly set project ref (inferred from SUPABASE_URL if omitted)
SUPABASE_PROJECT_REF=your-project-ref

# Meta Cloud API / WhatsApp Webhook Settings
WHATSAPP_API_TOKEN=EAAB...your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=100012345678901
WHATSAPP_VERIFY_TOKEN=your_secure_random_verification_token
WHATSAPP_APP_SECRET=your_meta_app_secret_for_hmac_sha256

# LLM & Audio Transcription Engine (Google Gemini / OpenAI / Groq)
GEMINI_API_KEY=your_google_gemini_api_key
LLM_API_KEY=your_fallback_llm_api_key
LLM_MODEL=gemini-2.5-flash
WHISPER_MODEL=whisper-1

# Monorepo Single-Tenant Prototype Default ID
DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001

# Ingestion Microservice Config
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
